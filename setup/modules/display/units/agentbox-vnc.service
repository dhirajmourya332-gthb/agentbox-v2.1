[Unit]
Description=agentbox VNC server for :99 (loopback only, password)
After=agentbox-xvfb.service
Requires=agentbox-xvfb.service

[Service]
User=@USER@
Environment=HOME=@HOME@
ExecStartPre=/bin/sh -c 'for i in $(seq 50); do DISPLAY=:99 xdpyinfo >/dev/null 2>&1 && exit 0; sleep 0.2; done; exit 1'
ExecStart=/usr/bin/x11vnc -display :99 -forever -shared -rfbauth @SECRETS@/vnc.passwd -localhost -rfbport 5900 -noxdamage -quiet
Restart=always

[Install]
WantedBy=multi-user.target
