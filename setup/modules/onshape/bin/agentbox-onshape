#!/usr/bin/env python3
"""Put CAD models into the owner's Onshape for review (the Onshape integration).

  agentbox-onshape whoami [--short]                 who the API keys belong to (checks the keys)
  agentbox-onshape upload FILE --doc NAME [--tab TAB] [--version LABEL] [--note TEXT]
        Uploads a STEP/STP (or STL, 3MF, Parasolid, IGES…) into the document NAME (created, private,
        when missing; the configured prefix is added), translated into a Part Studio named TAB
        (default: the file name). With --version, saves an Onshape version LABEL afterwards so the
        owner can compare uploads. Prints JSON: document, tab and version links.
  agentbox-onshape docs [QUERY]                     the owner's documents (name, link), newest first
  agentbox-onshape tabs --doc NAME                  a document's tabs (elements)

Keys: <secrets>/onshape.env (ONSHAPE_ACCESS_KEY, ONSHAPE_SECRET_KEY; made by `agentbox secret set
onshape.env`), never printed. Settings: `agentbox integration settings onshape` (base_url, doc_prefix,
allow_public). Only adds: it never deletes or edits existing documents, tabs or versions.
Uses Onshape's REST API (Basic auth with the API key, https://<base>/api/v12/…). Exit 0 = done.
"""
import base64
import json
import mimetypes
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

API = "/api/v12"
PAGE = 20  # Onshape rejects a larger `limit` on list calls (400 "must be less than or equal to 20")


class Fail(Exception):
    pass


def cli(*args):
    try:
        return subprocess.run(["agentbox", *args], capture_output=True, text=True, timeout=30).stdout.strip()
    except Exception:
        return ""


def settings():
    out = {"base_url": "https://cad.onshape.com", "doc_prefix": "", "allow_public": False}
    raw = cli("integration", "settings", "onshape", "--json")
    try:
        d = json.loads(raw) if raw else {}
        vals = d.get("values", d) if isinstance(d, dict) else {}
        for k in out:
            v = vals.get(k)
            if isinstance(v, dict):
                v = v.get("value")
            if v not in (None, ""):
                out[k] = v
    except ValueError:
        pass
    if os.environ.get("ONSHAPE_BASE_URL"):
        out["base_url"] = os.environ["ONSHAPE_BASE_URL"]
    out["base_url"] = str(out["base_url"]).rstrip("/")
    out["allow_public"] = out["allow_public"] in (True, "true", "yes", "1")
    return out


def keys():
    path = os.environ.get("ONSHAPE_KEYS_FILE") or os.path.join(cli("config", "get", "paths.secrets") or "/secrets", "onshape.env")
    vals = {}
    try:
        for line in open(path):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                vals[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        raise Fail("no Onshape keys yet: the owner adds them with `agentbox secret set onshape.env` (Integrations → Onshape)")
    a, s = vals.get("ONSHAPE_ACCESS_KEY", ""), vals.get("ONSHAPE_SECRET_KEY", "")
    if not a or not s:
        raise Fail("%s needs ONSHAPE_ACCESS_KEY and ONSHAPE_SECRET_KEY lines" % path)
    return a, s


class Onshape:
    def __init__(self):
        self.cfg = settings()
        a, s = keys()
        self.auth = "Basic " + base64.b64encode(("%s:%s" % (a, s)).encode()).decode()

    def call(self, method, path, body=None, query=None, raw=None, ctype=None, timeout=120):
        url = self.cfg["base_url"] + API + path + ("?" + urllib.parse.urlencode(query) if query else "")
        data, headers = None, {"Authorization": self.auth, "Accept": "application/json"}
        if raw is not None:
            data, headers["Content-Type"] = raw, ctype
        elif body is not None:
            data, headers["Content-Type"] = json.dumps(body).encode(), "application/json"
        req = urllib.request.Request(url, data=data, method=method, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                txt = r.read()
                return json.loads(txt) if txt else {}
        except urllib.error.HTTPError as e:
            msg = e.read()[:400].decode(errors="replace")
            if e.code in (401, 403):
                raise Fail("Onshape refused the keys (%d): check they're current and have read+write scopes. %s" % (e.code, msg))
            raise Fail("Onshape %s %s → %d: %s" % (method, path, e.code, msg))
        except urllib.error.URLError as e:
            raise Fail("can't reach %s: %s" % (self.cfg["base_url"], e.reason))

    def link(self, did, wid=None, eid=None):
        u = "%s/documents/%s" % (self.cfg["base_url"], did)
        if wid:
            u += "/w/%s" % wid
        if eid:
            u += "/e/%s" % eid
        return u

    def documents(self, q="", pages=10, **extra):
        """The owner's documents matching q, a page (PAGE) at a time, at most `pages` pages."""
        for n in range(pages):
            items = self.call("GET", "/documents", query=dict(q=q, filter=0, limit=PAGE, offset=n * PAGE, **extra)).get("items", [])
            yield from items
            if len(items) < PAGE:
                return

    def find_doc(self, name):
        return next((it for it in self.documents(name) if it.get("name") == name), None)

    def ensure_doc(self, name, note=""):
        d = self.find_doc(name)
        if d:
            return d, False
        body = {"name": name, "isPublic": bool(self.cfg["allow_public"]), "description": note[:200] or "Uploaded by agentbox for review"}
        try:
            return self.call("POST", "/documents", body), True
        except Fail as e:
            if not self.cfg["allow_public"] and ("public" in str(e).lower() or "private" in str(e).lower() or "plan" in str(e).lower()):
                raise Fail("Onshape won't create a private document on this plan (%s). The owner can upgrade, or allow public "
                           "documents: `sudo agentbox integration settings onshape --set allow_public=true`." % e)
            raise

    def workspace(self, doc):
        ws = (doc.get("defaultWorkspace") or {}).get("id")
        if ws:
            return ws
        r = self.call("GET", "/documents/%s" % doc["id"])
        return r["defaultWorkspace"]["id"]

    def upload(self, path, tab):
        name = tab if os.path.splitext(tab)[1] else tab + os.path.splitext(path)[1]
        boundary = "agentbox" + uuid.uuid4().hex
        fields = {"encodedFilename": name, "translate": "true", "storeInDocument": "false",
                  "flattenAssemblies": "false", "yAxisIsUp": "false", "notifyUser": "false"}
        parts = []
        for k, v in fields.items():
            parts.append(('--%s\r\nContent-Disposition: form-data; name="%s"\r\n\r\n%s\r\n' % (boundary, k, v)).encode())
        ctype = mimetypes.guess_type(path)[0] or "application/octet-stream"
        parts.append(('--%s\r\nContent-Disposition: form-data; name="file"; filename="%s"\r\nContent-Type: %s\r\n\r\n'
                      % (boundary, name.replace('"', ""), ctype)).encode())
        parts.append(open(path, "rb").read())
        parts.append(("\r\n--%s--\r\n" % boundary).encode())
        return b"".join(parts), "multipart/form-data; boundary=" + boundary

    def wait(self, tid, limit=600):
        t0, delay = time.time(), 1.5
        while time.time() - t0 < limit:
            r = self.call("GET", "/translations/%s" % tid)
            state = r.get("requestState")
            if state == "DONE":
                return r
            if state == "FAILED":
                raise Fail("Onshape couldn't translate the file: %s" % (r.get("failureReason") or "no reason given"))
            time.sleep(delay)
            delay = min(delay * 1.5, 8)
        raise Fail("the translation didn't finish in %d s (it may still appear in the document)" % limit)


def cmd_whoami(o, short):
    # sessioninfo answers an empty 200 even to a wrong key; listing documents needs a valid one (401 otherwise).
    o.call("GET", "/documents", query={"filter": 0, "limit": 1})
    r = o.call("GET", "/users/sessioninfo")
    if not (r.get("id") or r.get("email")):
        raise Fail("the key was accepted for documents but Onshape returned no account details; check the key's owner")
    who = r.get("email") or r.get("name")
    if short:
        print(who)
    else:
        print(json.dumps({"user": who, "name": r.get("name"), "base_url": o.cfg["base_url"],
                          "plan": (r.get("planGroup") or r.get("plan") or None)}, indent=1))


def cmd_upload(o, path, doc_name, tab, version, note):
    if not os.path.isfile(path):
        raise Fail("no such file: %s" % path)
    name = (o.cfg["doc_prefix"] or "") + doc_name
    tab = tab or os.path.splitext(os.path.basename(path))[0]
    doc, created = o.ensure_doc(name, note)
    did, wid = doc["id"], o.workspace(doc)
    body, ctype = o.upload(path, tab)
    info = o.call("POST", "/blobelements/d/%s/w/%s" % (did, wid), raw=body, ctype=ctype, timeout=600)
    tid = info.get("translationId")
    eid = None
    if tid:
        tr = o.wait(tid)
        eid = (tr.get("resultElementIds") or [None])[0]
    out = {"document": name, "created": created, "tab": tab, "link": o.link(did, wid, eid), "document_link": o.link(did, wid)}
    if version:
        v = o.call("POST", "/documents/d/%s/versions" % did,
                   {"documentId": did, "workspaceId": wid, "name": version[:250], "description": note[:1000]})
        out["version"] = version
        out["version_link"] = "%s/documents/%s/v/%s" % (o.cfg["base_url"], did, v.get("id")) if v.get("id") else None
    print(json.dumps(out, indent=1))


def cmd_docs(o, query):
    for it in o.documents(query or "", pages=3, sortColumn="modifiedAt", sortOrder="desc"):
        print("%-48s %s %s" % (it.get("name", "")[:48], "public " if it.get("public") else "private", o.link(it["id"])))


def cmd_tabs(o, doc_name):
    name = (o.cfg["doc_prefix"] or "") + doc_name
    d = o.find_doc(name)
    if not d:
        raise Fail("no document called %r" % name)
    wid = o.workspace(d)
    for e in o.call("GET", "/documents/d/%s/w/%s/elements" % (d["id"], wid)) or []:
        print("%-40s %-14s %s" % (e.get("name", "")[:40], e.get("elementType") or e.get("type", ""), o.link(d["id"], wid, e.get("id"))))


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]

    def opt(flag, default=None):
        if flag in rest:
            i = rest.index(flag)
            if i + 1 >= len(rest):
                raise Fail("%s needs a value" % flag)
            v = rest[i + 1]
            del rest[i:i + 2]
            return v
        return default
    try:
        if cmd == "whoami":
            cmd_whoami(Onshape(), "--short" in rest)
        elif cmd == "upload":
            doc, tab, version, note = opt("--doc"), opt("--tab"), opt("--version"), opt("--note", "")
            if not rest or not doc:
                raise Fail("usage: agentbox-onshape upload FILE --doc NAME [--tab TAB] [--version LABEL] [--note TEXT]")
            cmd_upload(Onshape(), rest[0], doc, tab, version, note)
        elif cmd == "docs":
            cmd_docs(Onshape(), " ".join(rest))
        elif cmd == "tabs":
            doc = opt("--doc")
            if not doc:
                raise Fail("usage: agentbox-onshape tabs --doc NAME")
            cmd_tabs(Onshape(), doc)
        else:
            raise Fail("unknown command %r (whoami, upload, docs, tabs)" % cmd)
    except Fail as e:
        print("agentbox-onshape: %s" % e, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
