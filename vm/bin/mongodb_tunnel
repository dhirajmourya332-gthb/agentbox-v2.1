#!/usr/bin/env bash
# A database tunnel: forwards the ports listed in FORWARDS (e.g. MongoDB, Redis, RabbitMQ) to
# 127.0.0.1 over SSH through AWS Session Manager. (The db-tunnel module replaces this with a
# generic, configurable tunnel; the command names are kept for compatibility.) Installed as three commands:
#   mongodb_tunnel_start   open it (no-op if it's already up)
#   mongodb_tunnel_status  is it up?
#   mongodb_tunnel_stop    close it
# Connection details (instance, region, user, key, forwards) live in /secrets/db-tunnel.conf.
set -euo pipefail

CONF=/secrets/db-tunnel.conf
STATE="$HOME/.agentbox"
PIDFILE="$STATE/mongodb-tunnel.pid"
LOG="$STATE/mongodb-tunnel.log"
mkdir -p "$STATE"
[ -r "$CONF" ] || { echo "error: $CONF is missing; ask the owner." >&2; exit 1; }
# shellcheck source=/dev/null
source "$CONF"   # INSTANCE, REGION, SSH_USER, KEY, FORWARDS (e.g. "27017 6379 5672")

running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }
ports_up() { for p in $FORWARDS; do nc -z -w 2 127.0.0.1 "$p" 2>/dev/null || return 1; done; }

status() {
  if running && ports_up; then
    echo "up: 127.0.0.1 ports $FORWARDS forwarded (pid $(cat "$PIDFILE"))"
  elif running; then
    echo "starting or broken: ssh is running (pid $(cat "$PIDFILE")) but not every port answers. Log: $LOG"
    return 1
  else
    echo "down"
    return 1
  fi
}

stop() {
  if running; then kill "$(cat "$PIDFILE")" 2>/dev/null || true; fi
  rm -f "$PIDFILE"
  echo "down"
}

start() {
  if running; then
    if ports_up; then status; return 0; fi
    stop >/dev/null
  fi
  for p in $FORWARDS; do
    if nc -z -w 1 127.0.0.1 "$p" 2>/dev/null; then echo "error: port $p is already in use by something else." >&2; exit 1; fi
  done
  local args=()
  for p in $FORWARDS; do args+=(-L "$p:localhost:$p"); done
  : > "$LOG"
  nohup ssh -i "$KEY" -N "${args[@]}" \
    -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
    -o StrictHostKeyChecking=accept-new -o BatchMode=yes \
    -o "ProxyCommand=aws ssm start-session --target $INSTANCE --document-name AWS-StartSSHSession --parameters portNumber=%p --region $REGION" \
    "$SSH_USER@$INSTANCE" >>"$LOG" 2>&1 &
  echo $! > "$PIDFILE"
  for _ in $(seq 40); do
    if ports_up; then status; return 0; fi
    if ! running; then
      echo "error: the tunnel failed to start. Last log lines:" >&2
      tail -5 "$LOG" >&2
      if grep -qiE "expired|credentials|token" "$LOG"; then
        echo "AWS sign-in looks expired or missing. Don't re-authenticate yourself: ask the owner." >&2
      fi
      rm -f "$PIDFILE"
      exit 1
    fi
    sleep 1
  done
  echo "error: timed out waiting for the ports. Log: $LOG" >&2
  exit 1
}

case "$(basename "$0")" in
  mongodb_tunnel_start) start ;;
  mongodb_tunnel_stop) stop ;;
  mongodb_tunnel_status) status ;;
  *)
    case "${1:-}" in
      start) start ;;
      stop) stop ;;
      status) status ;;
      *) echo "usage: mongodb_tunnel_start | mongodb_tunnel_status | mongodb_tunnel_stop" >&2; exit 2 ;;
    esac ;;
esac
